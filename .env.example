# Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Database Configuration (PostgreSQL in production; SQLite fallback supported locally)
DATABASE_URL=sqlite:///./job_agent.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/job_agent

# Security & Authentication
SECRET_KEY=change_this_to_a_secure_random_secret_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Application Configuration
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# File Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# Application Submission Safeguards
ENABLE_LIVE_SUBMISSIONS=true
